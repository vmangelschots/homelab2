# Template only — copy to secret.yaml (gitignored), fill in real values,
# then: kubectl apply -f secret.yaml
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Generate POSTGRES_PASSWORD with:
#   openssl rand -base64 32 | tr '+/' '-_'
apiVersion: v1
kind: Secret
metadata:
  name: telework-secrets
  namespace: telework
type: Opaque
stringData:
  # Consumed by the postgres container.
  POSTGRES_DB: telework
  POSTGRES_USER: telework
  POSTGRES_PASSWORD: CHANGE_ME

  # Consumed by Django. Must match POSTGRES_PASSWORD above.
  SECRET_KEY: CHANGE_ME
