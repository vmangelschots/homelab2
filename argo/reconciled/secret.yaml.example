# Copy to secret.yaml (gitignored) and replace every change-me.
#   DJANGO_SECRET_KEY: openssl rand -base64 64 | tr -d '\n' | tr '+/' '-_'
#   DB_PASSWORD:       openssl rand -base64 32 | tr '+/' '-_'
# BUDGET_APP_USERNAME/PASSWORD is the login account, created on first start
# and never changed afterwards (use `manage.py changepassword` to change it).
# OPENAI_API_KEY: from https://platform.openai.com/api-keys
apiVersion: v1
kind: Secret
metadata:
  name: reconciled-secrets
  namespace: reconciled
type: Opaque
stringData:
  DJANGO_SECRET_KEY: change-me
  DB_USER: reconciled
  DB_PASSWORD: change-me
  BUDGET_APP_USERNAME: change-me
  BUDGET_APP_PASSWORD: change-me
  OPENAI_API_KEY: change-me
